# FinTrack AI — Plantilla de Variables de Entorno
# Copia este archivo a .env.local para desarrollo local
# NUNCA subas archivos .env con valores reales al control de versiones

# Clave secreta para firma y verificación de tokens JWT (Mínimo 32 caracteres criptográficos)
JWT_SECRET=reemplaza_con_un_secreto_aleatorio_de_al_menos_32_caracteres

# Entorno de ejecución (development | production)
NODE_ENV=production

# Configuración de base de datos para producción (Opcional, si usas Supabase o PostgreSQL)
# DATABASE_URL=postgresql://usuario:password@host:5432/fintrack
